        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "I was a combat medic during the world war even though it cut my life
          short. A dangerous passion if you\u2019d say but my wife loved me for that.
          If only I can do it once more I\u2019d be happy."
        type: 0
        typeString: 
