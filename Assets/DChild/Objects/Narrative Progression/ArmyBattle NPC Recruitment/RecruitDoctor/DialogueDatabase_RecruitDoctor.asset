      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "Oh, well she\u2019s still alive. (slight chuckle) Everyday, I am
          filled with great sorrow for leaving her alone a bit too early. If only
          I had more time."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
