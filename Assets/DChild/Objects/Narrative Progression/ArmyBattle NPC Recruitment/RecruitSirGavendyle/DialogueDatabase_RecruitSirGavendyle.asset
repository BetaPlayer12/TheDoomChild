        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "How righteous\u2026 Impressive as these monuments are, the Lords
          seem distant and do a bad job at keeping balance."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
