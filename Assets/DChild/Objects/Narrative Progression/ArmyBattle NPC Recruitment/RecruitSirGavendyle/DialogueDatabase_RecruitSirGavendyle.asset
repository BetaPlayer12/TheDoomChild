      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "I came to see them. Majestic aren\u2019t they? The Death Lords have
          ruled for millenia\u2026 They keep balance to a realm that\u2019s ripe
          with conflict\u2014and let\u2019s not forget savages."
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 1911
      isRoot: 0
      isGroup: 0
      nodeColor: 
