      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "(Shouting) Go ahead and be childish! I\u2019m tired of you\u2014if
          someone offers me a job. I\u2019d drop everything and leave. "
