      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "(Shouting) Oi, you good for nothing butcher. (Jeering) Why don\u2019t
          you get a real job?\r"
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
